{
  "expo": {
    "name": "Choyeon Gym",
    "slug": "ChoyeonGym",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "choyeon-gym",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.choyeon.gym"
    },
    "android": {
      "package": "com.choyeon.gym",
      "adaptiveIcon": {
        "backgroundColor": "#F2F2F4",
        "foregroundImage": "./assets/adaptive/ic_launcher_foreground.png",
        "backgroundImage": "./assets/adaptive/ic_launcher_background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
