# 复制为 keystore.properties 并填入真实值（keystore.properties 已被 .gitignore 忽略）。
#
# 生成 keystore：
#   keytool -genkeypair -v -keystore choyeon-release.jks -storetype PKCS12 \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias choyeon \
#     -dname "CN=Choyeon, OU=Dev, O=Choyeon, L=Shanghai, ST=Shanghai, C=CN"
#
# 注意：换密钥 = 换签名。已安装旧版的用户必须先卸载才能装新版（数据会丢），
# 所以 keystore 一定要和源码分开、单独备份。

RELEASE_STORE_FILE=C:/ChoyeonExercises/choyeon-release.jks
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=choyeon
RELEASE_KEY_PASSWORD=
